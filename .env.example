# Required. SQLAlchemy connection string. postgresql:// is accepted and
# normalized to the psycopg3 driver automatically (see app/database.py).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/telemetry_db

# Required by the server (not the worker, which never touches Redis).
REDIS_URL=redis://localhost:6379

# Optional. Comma-separated list, or "*" for all origins. "*" is the
# deliberate default for now — there is no paired frontend deployed yet.
ALLOWED_ORIGINS=*

# Optional. Python logging level for both the server and the worker.
LOG_LEVEL=INFO

# Optional. How often the worker checks for loss-of-signal, in seconds.
LOS_CHECK_INTERVAL_SECONDS=60

# Optional. Only read by simulate.py, to point the traffic generator at a
# deployed instance instead of localhost.
SIMULATOR_BASE_URL=http://localhost:8000
